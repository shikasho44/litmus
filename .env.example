# Copy to .env.local for local development. Never commit real keys.
# Server-only variables (never exposed to the browser). See docs/engine.md.

OPENROUTER_API_KEY=
# HMAC key for progress tokens. REQUIRED in production (long random string).
SESSION_SECRET=change-me-to-a-long-random-string

# rules | jev | jev+llm | jev+llm+check | llm
# (unset → jev when OPENROUTER_API_KEY is set, else rules; unbuildable parts degrade to rules)
PIPELINE_MODE=jev
# jev | rules   (rules → never call a decision model, whatever the mode)
DECISION_PROVIDER=jev
JEV_MODEL=typesafe/jev-1.13
# openrouter | codex | none
LLM_PROVIDER=none
LLM_MODEL=
# ── AI tuning (optional, see docs/ai.md) ──────────────────
# JEV_CANDIDATES=all+prior     # topk | wide | all | topk+prior | wide+prior | all+prior (topk+prior ≈ 1/4 the cost)
# LLM_REASONING=off            # off | minimal | low | medium | high
# LLM_PROVIDER_SORT=latency    # latency | throughput | price
# CODEX_TRANSPORT=app-server   # app-server | exec   (dev only; also CODEX_BIN, CODEX_MODEL, CODEX_EFFORT, CODEX_TIMEOUT_MS)

# Estimated USD per UTC day per server instance. Over it → rules mode.
# 0 = never call paid models · negative = unlimited
DAILY_COST_LIMIT_USD=1

# Production admin (/api/admin/*): requests must send header  x-admin-token: <ADMIN_TOKEN>
# Empty → admin routes are 404 in production (always open on the dev server).
ADMIN_TOKEN=

# ── optional ─────────────────────────────────────────────
# APP_ENV=production        # development | production (vite dev → development, preview/Vercel → production)
# QUESTION_CAP=400          # max questions per progress token (429 after)
# CONTENT_ROOT=             # absolute path to content/ (auto-detected)
# TRACE_FILE=0              # dev: disable logs/trace-YYYY-MM-DD.jsonl

# ── browser build (VITE_*) ───────────────────────────────
# VITE_API_MODE=http        # http | embedded   (vite build --mode static → embedded)
# VITE_API_BASE=/api
