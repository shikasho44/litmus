# dependencies / build output
node_modules
dist
dist-*
*.tsbuildinfo

# local-only runtime output
logs/
qa/
.vercel
.vite
# wrangler (Cloudflare) local state and dry-run bundles (dist-worker/ is covered by dist-*)
.wrangler/
coverage/

# benchmark reports are regenerated by `npm run bench` (docs/admin.md §Bench):
# both the JSON and the HTML embed the probe bank (answer labels) and model outputs,
# so they stay local. Copy a report you want to keep as a baseline into bench/baselines/.
bench/reports/*.json
bench/reports/*.html

# secrets — only the template is committed
.env
.env.*
!.env.example

# editor / OS noise
__pycache__/
.DS_Store
Thumbs.db
*.log

# playtest transcripts (scripts/playtest.ts): full Q&A logs with case spoilers, local only
bench/reports/playtest/
.env*
