# Response headers for the static files on Cloudflare (Workers Static Assets).
# The same rules as vercel.json "headers". `npm run deploy:cf` copies this file to dist/_headers
# (it is not in public/, so the static build for fourthplace43.com never ships it).
# /api responses set their own headers in server/http/handler.ts.
#
# Cache-Control `no-transform` on pages keeps Cloudflare from rewriting them — in particular from
# injecting the zone's Web Analytics beacon (a third-party script the CSP blocks; the privacy
# policy says the game uses no analytics). max-age=0 + must-revalidate is the Workers default.
# Longer-cached paths below detach it (`! Cache-Control`) and set their own.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/art/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/cases/*
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Robots-Tag: noindex, nofollow, noimageindex

/og.png
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og.jpg
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
